# ==============================================================================
# CONFIGURACION DE INTERFAZ DE VOZ Y CHAT (INTERFACE MODULE)
# ==============================================================================

# Puerto en el que se ejecuta este servidor web/backend
PORT=8080

# ==============================================================================
# COMUNICACION ENTRE CONTENEDORES (RED DOCKER / DOMINIO = NOMBRE DEL CONTENEDOR)
# NOTA: Dentro de la red Docker compartida NO se usan IPs ni localhost.
# Se utiliza el nombre del contenedor correspondiente como dominio DNS.
# ==============================================================================

# Proxy LLM (servicio 'ollama-proxy')
LLM_URL=http://ollama-proxy:8000
LLM_API_KEY=cambia_esta_clave
LLM_MODEL=qwen2.5:0.5b

# Servicio TTS (servicio 'piper-tts')
TTS_URL=http://piper-tts:5000
TTS_VOICE=es_ES-sharvard-medium

# Servicio STT (servicio 'vosk-stt')
STT_URL=http://vosk-stt:2700

# Tiempo de silencio en milisegundos para detectar fin de turno al hablar en llamada
SILENCE_TIMEOUT_MS=700

# Enviar eventos de fondo (tool-calling, thinking, ejecucion interna) por WebSocket (false = mostrar, true = ocultar)
HIDE_BACKGROUND=false
